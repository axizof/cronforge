{
  "name": "cronforge",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript toolkit for cron expressions — parse, validate, describe (multilingual), iterate, and build for both standard Unix (5-field) and Quartz (6–7 field) dialects.",
  "keywords": [
    "cron",
    "crontab",
    "quartz",
    "scheduler",
    "scheduling",
    "expression",
    "parser",
    "validator",
    "i18n",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/battlefilm/cronforge.git"
  },
  "bugs": {
    "url": "https://github.com/battlefilm/cronforge/issues"
  },
  "homepage": "https://github.com/battlefilm/cronforge#readme",
  "author": "CronForge contributors",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/en.json": "./dist/locales/en.json",
    "./locales/fr.json": "./dist/locales/fr.json",
    "./locales/es.json": "./dist/locales/es.json",
    "./locales/de.json": "./dist/locales/de.json",
    "./locales/it.json": "./dist/locales/it.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-locales.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:jsdoc": "node scripts/check-jsdoc-coverage.mjs",
    "check:no-deps": "node scripts/check-no-runtime-deps.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:no-deps && npm run check:bundle-size && npm run check:jsdoc",
    "prepare": "husky",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
