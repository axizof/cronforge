{
  "name": "cronforge",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript toolkit for cron expressions: parse, validate, describe in 5 languages, compute next run times (timezone and DST aware) and build expressions from structured input. Standard Unix and Quartz dialects.",
  "keywords": [
    "cron",
    "crontab",
    "quartz",
    "scheduler",
    "scheduling",
    "expression",
    "parser",
    "validator",
    "i18n",
    "typescript"
  ],
  "license": "MIT",
  "author": "axizof",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axizof/cronforge.git"
  },
  "bugs": {
    "url": "https://github.com/axizof/cronforge/issues"
  },
  "homepage": "https://github.com/axizof/cronforge#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/*.json": "./dist/locales/*.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-locales.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:package && npm run check:size",
    "prepare": "husky",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
