{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/battlefilm/cronforge/shared-tests/cases.schema.json",
  "title": "CronForge shared-test fixture",
  "description": "Language-agnostic behavioural fixture consumed by every CronForge implementation.",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/TestCase" }
    }
  },
  "definitions": {
    "TestCase": {
      "type": "object",
      "required": ["id", "expression", "mode", "valid"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-\\d+$" },
        "expression": { "type": "string" },
        "mode": { "enum": ["standard", "quartz", "auto"] },
        "valid": { "type": "boolean" },
        "dialect": { "enum": ["standard", "quartz"] },
        "descriptors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "nextOccurrences": { "$ref": "#/definitions/NextOccurrencesCase" },
        "validation": {
          "type": "object",
          "required": ["errors"],
          "additionalProperties": false,
          "properties": {
            "errors": {
              "type": "array",
              "items": { "$ref": "#/definitions/ValidationErrorAssertion" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "NextOccurrencesCase": {
      "type": "object",
      "required": ["from", "count", "expected"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "count": { "type": "integer", "minimum": 0 },
        "timezone": { "type": "string" },
        "expected": {
          "type": "array",
          "items": { "type": "string", "format": "date-time" }
        }
      }
    },
    "ValidationErrorAssertion": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "field": {
          "enum": ["seconds", "minute", "hour", "dom", "month", "dow", "year", "whole"]
        }
      }
    }
  }
}
