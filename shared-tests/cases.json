    {
      "id": "dst-001",
      "expression": "30 2 * * *",
      "mode": "standard",
      "valid": true,
      "dialect": "standard",
      "nextOccurrences": {
        "from": "2026-03-29T00:00:00Z",
        "count": 1,
        "timezone": "Europe/Paris",
        "expected": ["2026-03-30T00:30:00Z"]
      },
      "notes": "Spring-forward in Europe/Paris: 02:30 on 2026-03-29 does not exist; iterator advances to the next valid 02:30."
    },
    {
      "id": "dst-002",
      "expression": "30 2 * * *",
      "mode": "standard",
      "valid": true,
      "dialect": "standard",
      "nextOccurrences": {
        "from": "2026-10-24T22:00:00Z",
        "count": 2,
        "timezone": "Europe/Paris",
        "expected": ["2026-10-25T00:30:00Z", "2026-10-26T01:30:00Z"]
      },
      "notes": "Fall-back overlap in Europe/Paris: 02:30 fires once at the FIRST wall-clock instance (CEST = 00:30 UTC)."
    },
